# 复制成 .deploy.env 后填写：cp .deploy.env.example .deploy.env
DEPLOY_HOST=""            # 服务器 IP 或域名
DEPLOY_PORT="22"
DEPLOY_USER="root"
DEPLOY_PATH=""            # 网站根目录，留空自动探测
DEPLOY_PATH_CONFIRMED="0"
DEPLOY_KEY=".deploy/id_ed25519"
DEPLOY_DELETE="1"         # 1=完全同步 0=只覆盖
DEPLOY_BUILD="1"          # 1=部署前自动 npm run build
DEPLOY_BACKUPS="2"        # 服务器保留快照数
DEPLOY_PUBLIC_URL=""      # 可选探活地址
